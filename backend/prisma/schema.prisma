generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String               @id @default(uuid())
  email                   String               @unique
  passwordHash            String
  role                    String               @default("STUDENT")
  status                  String               @default("PENDING")
  emailVerified           Boolean              @default(false)
  emailVerifiedAt         DateTime?
  recruiterVerified       Boolean              @default(false)
  displayName             String?
  profilePhoto            String?
  blockInfo               String?
  googleCalendarConnected Boolean              @default(false)
  connectedGoogleEmail    String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  lastLoginAt             DateTime?
  sessionVersion          Int                  @default(0)
  adminRequests           AdminRequest[]
  admin                   Admin?
  googleCalendarToken     GoogleCalendarToken?
  notifications           Notification[]
  recruiter               Recruiter?
  refreshTokens           RefreshToken[]
  queries                 StudentQuery[]
  student                 Student?
  jobsCreated             Job[]                @relation("JobCreatedBy")
  jobsUpdated             Job[]                @relation("JobUpdatedBy")

  @@index([email])
  @@index([role, status])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model OTP {
  id        String   @id @default(uuid())
  email     String
  otp       String
  purpose   String   @default("VERIFY_EMAIL")
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, purpose, isUsed])
  @@index([expiresAt])
  @@map("otps")
}

model Student {
  assessmentAssignments      AssessmentAssignment[]
  id                         String                 @id @default(uuid())
  userId                     String                 @unique
  fullName                   String
  email                      String                 @unique
  phone                      String
  enrollmentId               String?                @unique
  /// Indicates whether student has completed mandatory profile fields at least once
  profileCompleted           Boolean                @default(false) @map("profile_completed")
  cgpa                       Float?
  backlogs                   String?
  batch                      String
  center                     String
  school                     String
  branch                     String?
  batchId                    String?
  centerId                   String?
  schoolId                   String?
  bio                        String?
  headline                   String?
  summary                    String?
  city                       String?
  stateRegion                String?
  jobFlexibility             String?
  profileImageUrl            String?
  profileImagePublicId       String?
  linkedin                   String?
  githubUrl                  String?
  youtubeUrl                 String?
  leetcode                   String?
  codeforces                 String?
  gfg                        String?
  hackerrank                 String?
  otherProfiles              String?
  resumeUrl                  String?
  resumeFileName             String?
  resumeUploadedAt           DateTime?
  statsApplied               Int                    @default(0)
  statsShortlisted           Int                    @default(0)
  statsInterviewed           Int                    @default(0)
  statsOffers                Int                    @default(0)
  emailNotificationsDisabled Boolean                @default(false)
  publicProfileId            String?                @unique
  publicProfileShowEmail     Boolean                @default(true)
  publicProfileShowPhone     Boolean                @default(false)
  endorsementsData           String?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  achievements               Achievement[]
  applications               Application[]
  certifications             Certification[]
  codingProfiles             CodingProfile[]
  education                  Education[]
  endorsementTokens          EndorsementToken[]
  endorsements               Endorsement[]
  experiences                Experience[]
  interviewEvaluations       InterviewEvaluation[]
  jobTracking                JobTracking[]
  jobTargets                 JobTarget[]
  projects                   Project[]
  skills                     Skill[]
  resumeFiles                StudentResumeFile[]
  assessmentSessions         AssessmentSession[]
  mockInterviewSlots         MockInterviewSlot[]
  aiMockInterviewEnrollments AiMockInterviewEnrollment[]
  activityLogs               StudentActivityLog[]
  user                       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([center])
  @@index([school])
  @@index([batch])
  @@index([emailNotificationsDisabled, createdAt])
  @@map("students")
}

model Skill {
  id        String   @id @default(uuid())
  studentId String
  skillName String
  rating    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillName])
  @@index([studentId, skillName])
  @@map("skills")
}

model Education {
  id          String   @id @default(uuid())
  studentId   String
  degree      String
  institution String
  startYear   Int?
  endYear     Int?
  cgpa        Decimal?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, endYear])
  @@map("education")
}

model Experience {
  id          String   @id @default(uuid())
  studentId   String
  title       String
  company     String
  start       String
  end         String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, start])
  @@map("experiences")
}

model Project {
  id               String   @id @default(uuid())
  studentId        String
  title            String
  description      String?
  technologies     String
  githubUrl        String?
  liveUrl          String?
  ai_summary       String?
  ai_bullets       String?
  skills_extracted String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("projects")
}

model Achievement {
  id             String    @id @default(uuid())
  studentId      String
  title          String
  description    String?
  date           DateTime?
  hasCertificate Boolean   @default(false)
  certificateUrl String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("achievements")
}

model Certification {
  id             String    @id @default(uuid())
  studentId      String
  title          String
  description    String?
  issuedDate     DateTime?
  expiryDate     DateTime?
  certificateUrl String?
  issuer         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, issuedDate])
  @@map("certifications")
}

model CodingProfile {
  id         String   @id @default(uuid())
  studentId  String
  platform   String
  profileUrl String
  username   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, platform])
  @@index([studentId, platform])
  @@map("coding_profiles")
}

model Company {
  id          String      @id @default(uuid())
  name        String      @unique
  logo        String?
  website     String?
  location    String?
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  jobs        Job[]
  recruiters  Recruiter[]

  @@index([name])
  @@map("companies")
}

model Recruiter {
  id               String                 @id @default(uuid())
  userId           String                 @unique
  companyId        String?
  companyName      String?
  location         String?
  relationshipType String?
  zone             String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  jobs             Job[]
  mouDocuments     RecruiterMouDocument[]
  company          Company?               @relation(fields: [companyId], references: [id])
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recruiters")
}

model RecruiterMouDocument {
  id          String    @id @default(uuid())
  recruiterId String
  fileUrl     String
  publicId    String?
  fileName    String?
  createdAt   DateTime  @default(now())
  recruiter   Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@index([recruiterId])
  @@map("recruiter_mou_documents")
}

model Job {
  id                          String                     @id @default(uuid())
  jobTitle                    String
  description                 String
  requirements                String
  requiredSkills              String
  companyId                   String?
  recruiterId                 String?
  companyName                 String?
  recruiterEmail              String?
  recruiterName               String?
  recruiterEmails             String?
  salary                      String?
  ctc                         String?
  salaryRange                 String?
  location                    String?
  companyLocation             String?
  driveDate                   DateTime?
  applicationDeadline         DateTime
  jobType                     String?
  workMode                    String?
  experienceLevel             String?
  driveVenues                 String
  reportingTime               String?
  qualification               String?
  specialization              String?
  yop                         String?
  minCgpa                     String?
  gapAllowed                  String?
  gapYears                    String?
  backlogs                    String?
  spocs                       String
  status                      String                     @default("IN_REVIEW")
  isActive                    Boolean                    @default(false)
  isPosted                    Boolean                    @default(false)
  applicationDeadlineMailSent Boolean                    @default(false)
  driveReminder7dSent         Boolean                    @default(false)
  driveReminder3dSent         Boolean                    @default(false)
  driveReminder24hSent        Boolean                    @default(false)
  adminNote                   String?
  recruiterNote               String?
  interviewRounds             String?
  customQuestions             String                     @default("[]")
  requiresScreening           Boolean                    @default(false)
  requiresTest                Boolean                    @default(false)
  targetSchools               String
  targetCenters               String
  targetBatches               String
  targetBranches              String                     @default("[]")
  targetSchoolIds             String                     @default("[]")
  targetCenterIds             String                     @default("[]")
  targetBatchIds              String                     @default("[]")
  submittedAt                 DateTime?
  postedAt                    DateTime?
  postedBy                    String?
  approvedAt                  DateTime?
  approvedBy                  String?
  rejectedAt                  DateTime?
  rejectedBy                  String?
  rejectionReason             String?
  archivedAt                  DateTime?
  archivedBy                  String?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  applications                Application[]
  interviewSession            InterviewSession?
  interviews                  Interview?
  jobTracking                 JobTracking[]
  jobTargets                  JobTarget[]
  company                     Company?                   @relation(fields: [companyId], references: [id])
  recruiter                   Recruiter?                 @relation(fields: [recruiterId], references: [id])
  screeningSession            RecruiterScreeningSession?
  visibilityMode              String                     @default("OPEN")
  recommendationEnabled       Boolean                    @default(false)
  createdBy                   String?
  creator                     User?                      @relation("JobCreatedBy", fields: [createdBy], references: [id])
  assignedTo                  String?
  updatedBy                   String?
  updater                     User?                      @relation("JobUpdatedBy", fields: [updatedBy], references: [id])

  @@index([status, createdAt])
  @@index([isActive, createdAt])
  @@index([recruiterId, createdAt])
  @@index([isPosted, createdAt])
  @@index([applicationDeadline, applicationDeadlineMailSent, status])
  @@index([targetSchools])
  @@index([targetCenters])
  @@index([targetBatches])
  @@map("jobs")
}

model JobTracking {
  id        String    @id @default(uuid())
  studentId String
  jobId     String
  isNew     Boolean   @default(true)
  viewed    Boolean   @default(false)
  viewedAt  DateTime?
  applied   Boolean   @default(false)
  appliedAt DateTime?
  createdAt DateTime  @default(now())
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, jobId])
  @@index([studentId, createdAt])
  @@index([jobId])
  @@index([studentId, viewed])
  @@map("job_tracking")
}

model JobTarget {
  id              String    @id @default(uuid())
  jobId           String
  studentId       String
  score           Float     @default(0)
  sourceMode      String    @default("SYSTEM")
  selectedByAdmin Boolean   @default(false)
  viewedAt        DateTime?
  appliedAt       DateTime?
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([jobId, studentId])
  @@index([jobId])
  @@index([studentId])
  @@map("job_student_targets")
}

model Application {
  id                   String            @id @default(uuid())
  studentId            String
  jobId                String
  companyId            String?
  status               String            @default("APPLIED")
  appliedDate          DateTime          @default(now())
  interviewDate        DateTime?
  screeningStatus      String?           @default("APPLIED")
  screeningRemarks     String?
  screeningCompletedAt DateTime?
  interviewStatus      String?
  lastRoundReached     Int?              @default(0)
  notes                String?
  revokedBy            String?
  revokedAt            DateTime?
  revokedReason        String?
  previousStatus       String?
  /// Normalized placement pipeline (single source of truth for Job Opportunities dashboard)
  pipelineStatus       String?
  pipelineSubStatus    String?
  segment              String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  job                  Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student              Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  roundEvaluations     RoundEvaluation[]

  @@unique([studentId, jobId])
  @@index([studentId, appliedDate])
  @@index([studentId, createdAt])
  @@index([jobId, createdAt])
  @@index([status, createdAt])
  @@index([interviewStatus])
  @@index([screeningStatus])
  @@index([revokedBy])
  @@index([pipelineStatus, pipelineSubStatus])
  @@index([segment, appliedDate])
  @@map("applications")
}

model Resume {
  id           String   @id @default(uuid())
  userId       String
  resumeId     String   @default("default")
  originalText String   @default("")
  enhancedText String   @default("")
  previewMode  String   @default("original")
  fileUrl      String?
  fileName     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, resumeId])
  @@index([userId, resumeId])
  @@map("resumes")
}

model StudentResumeFile {
  id         String   @id @default(uuid())
  studentId  String
  userId     String
  fileUrl    String
  fileName   String
  fileSize   Int?
  publicId   String
  title      String?
  isDefault  Boolean  @default(false)
  uploadedAt DateTime @default(now())
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, uploadedAt])
  @@index([studentId, isDefault])
  @@index([userId, uploadedAt])
  @@map("student_resume_files")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String
  data      String    @default("{}")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model EmailNotification {
  id         String    @id @default(uuid())
  jobId      String?
  userId     String?
  status     String    @default("PENDING")
  recipients String
  subject    String?
  body       String?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
  @@index([jobId, createdAt])
  @@map("email_notifications")
}

model StudentQuery {
  id          String    @id @default(uuid())
  studentId   String
  type        String    @default("question")
  subject     String
  message     String
  status      String    @default("OPEN")
  metadata    String?   @default("{}")
  response    String?
  respondedBy String?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([status, createdAt])
  @@map("student_queries")
}

model Endorsement {
  id            String            @id @default(uuid())
  studentId     String
  tokenId       String?           @unique
  endorserName  String
  endorserEmail String
  endorserRole  String
  organization  String
  relationship  String
  context       String?
  message       String
  skills        String            @default("[]")
  skillRatings  String?
  overallRating Int?
  consent       Boolean           @default(false)
  verified      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  submittedAt   DateTime          @default(now())
  student       Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  token         EndorsementToken? @relation(fields: [tokenId], references: [id])

  @@index([studentId, createdAt])
  @@index([endorserEmail])
  @@index([consent])
  @@map("endorsements")
}

model EndorsementToken {
  id           String       @id @default(uuid())
  studentId    String
  email        String
  token        String       @unique
  expiresAt    DateTime
  used         Boolean      @default(false)
  usedAt       DateTime?
  ipAddress    String?
  createdAt    DateTime     @default(now())
  teacherName  String?
  teacherRole  String?
  organization String?
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  endorsement  Endorsement?

  @@index([token])
  @@index([studentId, createdAt])
  @@index([email])
  @@index([used, expiresAt])
  @@map("endorsement_tokens")
}

// --- MOCK INTERVIEW SYSTEM MODELS ---

model MockInterviewDrive {
  id               String   @id @default(uuid())
  title            String
  category         String // HR, TECHNICAL, BEHAVIORAL, etc.
  enableCodeConsole Boolean @default(false) // live room code editor / tech board
  codingQuestions  String?  // JSON array: { id, title, description, starterCode, language }
  description      String?
  instructions     String?
  date             DateTime
  startTime        DateTime
  endTime          DateTime
  slotDuration     Int // in minutes
  breakDuration    Int      @default(5)
  bufferTime       Int      @default(0)
  targetBatches    String? // JSON array of strings
  targetBranches   String? // JSON array of strings
  targetStudentIds String? // JSON array of strings (for cherry-picking)
  status           String   @default("DRAFT") // DRAFT, PUBLISHED, COMPLETED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  slots MockInterviewSlot[]

  @@map("mock_interview_drives")
}

model MockInterviewSlot {
  id            String   @id @default(uuid())
  driveId       String
  studentId     String?
  interviewerId String?
  startTime     DateTime
  endTime       DateTime
  status        String   @default("AVAILABLE") // AVAILABLE, SCHEDULED, WAITING, LIVE, COMPLETED, MISSED, NO_SHOW, CANCELLED
  meetingRoomId String?  @unique
  joinLink      String?
  liveCode           String?  @db.Text
  liveCodeLanguage   String?  @default("javascript")
  activeQuestionId   String?
  extraQuestions     String?  // JSON — questions added live in the room

  drive      MockInterviewDrive       @relation(fields: [driveId], references: [id], onDelete: Cascade)
  student    Student?                 @relation(fields: [studentId], references: [id])
  feedback   MockInterviewFeedback?
  recordings MockInterviewRecording[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driveId])
  @@index([studentId])
  @@index([interviewerId])
  @@map("mock_interview_slots")
}

model MockInterviewFeedback {
  id                 String  @id @default(uuid())
  slotId             String  @unique
  communication      Int // 1-5
  confidence         Int // 1-5
  technicalSkills    Int // 1-5
  problemSolving     Int // 1-5
  bodyLanguage       Int // 1-5
  resumeKnowledge    Int // 1-5
  overallPerformance Int // 1-5
  result             String // EXCELLENT, GOOD, AVERAGE, NEEDS_IMPROVEMENT
  detailedRemarks    String?

  slot MockInterviewSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("mock_interview_feedback")
}

model MockInterviewRecording {
  id        String   @id @default(uuid())
  slotId    String
  videoUrl  String
  fileSize  Int?
  duration  Int? // in seconds
  createdAt DateTime @default(now())

  slot MockInterviewSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@map("mock_interview_recordings")
}

// --- AI VIDEO MOCK INTERVIEW (one-way, async) ---

model AiMockInterview {
  id               String   @id @default(uuid())
  title            String
  description      String?
  sessionMode      String   @default("GUIDED") // GUIDED, CONVERSATIONAL
  interviewType    String // HR, TECHNICAL, BEHAVIORAL, MIXED, PLACEMENT_READINESS, CUSTOM
  instructions     String?  @db.Text
  conversationalTopic    String?  @db.Text
  conversationalMaxTurns   Int      @default(8)
  startDate        DateTime
  endDate          DateTime
  targetBatches    String? // JSON array of batch IDs or labels
  targetBranches   String? // JSON array
  targetCenters    String? // JSON array (campuses)
  targetSchoolIds  String? // JSON array of school UUIDs
  targetStudentIds String? // JSON array of student UUIDs
  status           String   @default("DRAFT") // DRAFT, PUBLISHED, COMPLETED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  questions    AiMockInterviewQuestion[]
  enrollments  AiMockInterviewEnrollment[]

  @@map("ai_mock_interviews")
}

model AiMockInterviewQuestion {
  id                String   @id @default(uuid())
  interviewId       String
  orderIndex        Int
  questionText      String   @db.Text
  notes             String?  @db.Text
  prepTimeSeconds   Int      @default(30)
  answerTimeSeconds Int      @default(120)
  mandatory         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  interview AiMockInterview        @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  answers   AiMockInterviewAnswer[]

  @@index([interviewId, orderIndex])
  @@map("ai_mock_interview_questions")
}

model AiMockInterviewEnrollment {
  id                   String    @id @default(uuid())
  interviewId          String
  studentId            String
  status               String    @default("ASSIGNED") // ASSIGNED, IN_PROGRESS, COMPLETED
  currentQuestionIndex Int       @default(0)
  progressPercent      Int       @default(0)
  totalDurationSeconds Int       @default(0)
  violationsCount      Int       @default(0)
  riskLevel            String    @default("LOW") // LOW, MEDIUM, HIGH
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  interview    AiMockInterview              @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  student      Student                      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers      AiMockInterviewAnswer[]
  violations   AiMockInterviewViolation[]
  screenshots  AiMockInterviewScreenshot[]
  review       AiMockInterviewReview?
  aiInsight    AiMockInterviewAiInsight?

  @@unique([interviewId, studentId])
  @@index([studentId])
  @@index([interviewId, status])
  @@map("ai_mock_interview_enrollments")
}

model AiMockInterviewAnswer {
  id                 String    @id @default(uuid())
  enrollmentId       String
  questionId         String
  videoUrl           String?
  videoPublicId      String?
  audioUrl           String?
  audioPublicId      String?
  durationSeconds    Int?
  transcriptText      String?  @db.Text
  transcriptStatus    String?  // PENDING, COMPLETED, FAILED, SKIPPED
  acknowledgementText String?  @db.Text
  transitionText     String?  @db.Text
  submittedAt        DateTime?
  createdAt          DateTime  @default(now())

  enrollment AiMockInterviewEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  question   AiMockInterviewQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, questionId])
  @@map("ai_mock_interview_answers")
}

model AiMockInterviewViolation {
  id           String   @id @default(uuid())
  enrollmentId String
  type         String
  details      String?  @db.Text
  meta         String?  @db.Text
  timestamp    DateTime @default(now())

  enrollment AiMockInterviewEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@map("ai_mock_interview_violations")
}

model AiMockInterviewScreenshot {
  id           String   @id @default(uuid())
  enrollmentId String
  imageUrl     String
  publicId     String?
  captureType  String   @default("PERIODIC") // PERIODIC, EVENT
  event        String?
  riskFlag     Boolean  @default(false)
  faceCount    Int?
  timestamp    DateTime @default(now())

  enrollment AiMockInterviewEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@map("ai_mock_interview_screenshots")
}

model AiMockInterviewReview {
  id              String   @id @default(uuid())
  enrollmentId    String   @unique
  overallRating   Int? // 1-10
  comments        String?  @db.Text
  strengths       String?  @db.Text
  improvements    String?  @db.Text
  questionNotes   String?  @db.Text // JSON: { questionId: { rating, comment } }
  reviewedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  enrollment AiMockInterviewEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("ai_mock_interview_reviews")
}

model AiMockInterviewAiInsight {
  id                      String   @id @default(uuid())
  enrollmentId            String   @unique
  communicationScore      Int?
  confidenceScore         Int?
  clarityScore            Int?
  technicalUnderstanding  Int?
  technicalDepthScore     Int?
  professionalismScore    Int?
  behavioralScore         Int?
  overallPerformance      Int?
  strengths               String?  @db.Text
  improvements            String?  @db.Text
  recommendedFocus        String?  @db.Text
  interviewSummary        String?  @db.Text
  improvementPlan         String?  @db.Text
  rawJson                 String?  @db.Text
  status                  String   @default("PENDING") // PENDING, COMPLETED, FAILED
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  enrollment AiMockInterviewEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("ai_mock_interview_ai_insights")
}

model AdminRequest {
  id          String    @id @default(uuid())
  userId      String
  email       String
  reason      String?
  status      String    @default("PENDING")
  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  approvedBy  String?
  rejectedAt  DateTime?
  rejectedBy  String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, requestedAt])
  @@map("admin_requests")
}

model Announcement {
  id              String   @id @default(uuid())
  title           String
  description     String
  link            String?
  imageUrl        String?
  imagePublicId   String?
  targetSchools   String?
  targetBatches   String?
  targetCenters   String?
  targetSchoolIds String?  @default("[]")
  targetBatchIds  String?  @default("[]")
  targetCenterIds String?  @default("[]")
  createdBy       String
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@map("announcements")
}

model Admin {
  id               String   @id @default(uuid())
  userId           String   @unique
  name             String?
  role             String   @default("ADMIN")
  permissions      String   @default("[]")
  allowedSchools   String   @default("[]")
  allowedCenters   String   @default("[]")
  allowedBatches   String   @default("[]")
  allowedSchoolIds String   @default("[]")
  allowedCenterIds String   @default("[]")
  allowedBatchIds  String   @default("[]")
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admins")
}

model GoogleCalendarToken {
  id                   String    @id @default(uuid())
  userId               String    @unique
  accessToken          String
  refreshToken         String?
  expiryDate           DateTime?
  scope                String?
  connectedGoogleEmail String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([connectedGoogleEmail])
  @@map("google_calendar_tokens")
}

model Interview {
  id                 String                @id @default(uuid())
  jobId              String                @unique
  companyId          String?
  status             String                @default("ONGOING")
  currentRound       String?
  rounds             String                @default("[]")
  totalCandidates    Int                   @default(0)
  doneCandidates     Int                   @default(0)
  pendingCandidates  Int                   @default(0)
  selectedCandidates Int                   @default(0)
  onHoldCandidates   Int                   @default(0)
  createdBy          String?
  sessionToken       String?               @unique
  startedAt          DateTime              @default(now())
  completedAt        DateTime?
  activities         InterviewActivity[]
  evaluations        InterviewEvaluation[]
  job                Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([status, startedAt])
  @@index([jobId])
  @@index([createdBy])
  @@index([sessionToken])
  @@map("interviews")
}

model InterviewEvaluation {
  id          String    @id @default(uuid())
  interviewId String
  studentId   String
  roundName   String
  marks       Float?
  remarks     String?
  status      String?
  evaluatedBy String?
  evaluatedAt DateTime  @default(now())
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([interviewId, studentId, roundName])
  @@index([interviewId, roundName])
  @@index([studentId])
  @@map("interview_evaluations")
}

model InterviewActivity {
  id           String    @id @default(uuid())
  interviewId  String
  studentId    String?
  roundName    String?
  activityType String
  message      String
  metadata     String?
  performedBy  String?
  createdAt    DateTime  @default(now())
  interview    Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId, createdAt])
  @@index([activityType])
  @@map("interview_activities")
}

model InterviewSession {
  id                 String              @id @default(uuid())
  jobId              String              @unique
  companyId          String?
  status             String              @default("NOT_STARTED")
  createdBy          String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  startedAt          DateTime?
  completedAt        DateTime?
  rounds             InterviewRound[]
  job                Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviewerInvites InterviewerInvite[]

  @@index([status, createdAt])
  @@index([jobId])
  @@index([createdBy])
  @@map("interview_sessions")
}

model InterviewRound {
  id          String            @id @default(uuid())
  sessionId   String
  roundNumber Int
  name        String
  status      String            @default("LOCKED")
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  session     InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evaluations RoundEvaluation[]

  @@unique([sessionId, roundNumber])
  @@unique([sessionId, name])
  @@index([sessionId, roundNumber])
  @@index([status])
  @@map("interview_rounds")
}

model InterviewerInvite {
  id        String           @id @default(uuid())
  sessionId String
  email     String
  token     String           @unique
  expiresAt DateTime
  used      Boolean          @default(false)
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, email])
  @@index([token])
  @@index([sessionId])
  @@index([email])
  @@index([used, expiresAt])
  @@map("interviewer_invites")
}

model RoundEvaluation {
  id               String         @id @default(uuid())
  roundId          String
  applicationId    String
  interviewerEmail String
  status           String?
  remarks          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  application      Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  round            InterviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, applicationId])
  @@index([roundId])
  @@index([applicationId])
  @@index([status])
  @@map("round_evaluations")
}

model School {
  id                   String                 @id @default(uuid())
  name                 String                 @unique
  code                 String?                @unique
  status               String                 @default("ACTIVE")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  AssessmentAssignment AssessmentAssignment[]

  @@map("schools")
}

model Center {
  id        String   @id @default(uuid())
  name      String   @unique
  location  String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("centers")
}

model Batch {
  id                   String                 @id @default(uuid())
  year                 String                 @unique
  label                String?
  status               String                 @default("ACTIVE")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  AssessmentAssignment AssessmentAssignment[]

  @@map("batches")
}

model RecruiterScreeningSession {
  id          String    @id @default(uuid())
  jobId       String    @unique
  token       String    @unique
  expiresAt   DateTime
  finalizedAt DateTime?
  createdAt   DateTime  @default(now())
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([jobId])
  @@index([expiresAt])
  @@map("recruiter_screening_sessions")
}

/// Event-sourced activity (logins, mocks, engagement). Scores are never stored on Student.
model StudentActivityLog {
  id           String   @id @default(uuid())
  studentId    String
  eventType    String
  eventSubtype String?
  metadata     String?
  occurredAt   DateTime @default(now())
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, eventType])
  @@index([studentId, occurredAt])
  @@map("student_activity_logs")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorName  String?  @map("actor_name")
  actorRole  String?  @map("actor_role")
  actorId    String?  @map("actor_id")
  actionType String   @map("action_type")
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  details    String?  @map("details")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  timestamp  DateTime @default(now())

  @@index([actorRole])
  @@index([actionType])
  @@index([targetType])
  @@index([timestamp])
  @@map("audit_logs")
}


model Assessment {
  id           String                 @id @default(uuid())
  title        String
  description  String?
  type         String // MOCK_TEST, CODING_TEST, DESCRIPTIVE, MIXED
  difficulty   String                 @default("MEDIUM")
  duration     Int // in minutes
  startTime    DateTime?
  endTime      DateTime?
  instructions String?
  status       String                 @default("PUBLISHED") // DRAFT, PUBLISHED
  config       String                 @default("{}") // JSON: proctoring settings
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  questions    AssessmentQuestion[]
  sessions     AssessmentSession[]
  assignments  AssessmentAssignment[]

  @@map("assessments")
}

model AssessmentQuestion {
  id            String     @id @default(uuid())
  assessmentId  String
  questionText  String
  description   String?
  type          String // MCQ, CODING, DESCRIPTIVE
  options       String? // JSON for MCQ
  correctAnswer String?
  points        Int        @default(1)
  order         Int        @default(0)
  difficulty    String     @default("MEDIUM")
  starterCode   String? // For coding questions
  constraints   String?    @db.Text // Coding: limits (time, memory, input bounds)
  examples      String? // JSON: [{ input, output, explanation }] — shown to students
  testCases     String? // JSON: [{ input, expectedOutput, hidden }] — judge cases
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("assessment_questions")
}

model AssessmentAssignment {
  id           String     @id @default(uuid())
  assessmentId String
  studentId    String?
  batchId      String?
  schoolId     String?
  scheduledAt  DateTime?
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student      Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch        Batch?     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  school       School?    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("assessment_assignments")
}

model AssessmentSession {
  id              String                 @id @default(uuid())
  assessmentId    String
  studentId       String
  startTime       DateTime               @default(now())
  endTime         DateTime?
  status          String                 @default("IN_PROGRESS") // NOT_STARTED, IN_PROGRESS, SUBMITTED, AUTO_SUBMITTED, TERMINATED
  score           Float?
  responses       String? // JSON string of answers
  violationsCount Int                    @default(0)
  riskLevel       String                 @default("LOW") // LOW, MEDIUM, HIGH
  assessment      Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student         Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  violations      AssessmentViolation[]
  media           AssessmentMedia[]
  screenshots     AssessmentScreenshot[]

  @@unique([assessmentId, studentId])
  @@index([assessmentId])
  @@index([studentId])
  @@map("assessment_sessions")
}

model AssessmentViolation {
  id        String            @id @default(uuid())
  sessionId String
  type      String // TAB_SWITCH, NO_FACE, MULTIPLE_FACES, WINDOW_BLUR, FULLSCREEN_EXIT
  timestamp DateTime          @default(now())
  details   String?
  meta         String? // JSON string: device info, face count, etc.
  session      AssessmentSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  screenshots  AssessmentScreenshot[]

  @@index([sessionId])
  @@map("assessment_violations")
}

model AssessmentMedia {
  id        String            @id @default(uuid())
  sessionId String
  type      String // SCREENSHOT, VIDEO_ANSWER
  url       String
  timestamp DateTime          @default(now())
  session   AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("assessment_media")
}

model AssessmentScreenshot {
  id          String               @id @default(uuid())
  sessionId   String
  imageUrl    String
  publicId    String? // Cloudinary public_id (for signed/controlled access)
  captureType String               @default("PERIODIC") // PERIODIC | EVENT
  event       String? // TAB_SWITCH, NO_FACE_DETECTED, grouped events, etc.
  riskFlag    Boolean              @default(false)
  violationId String?
  flags       String? // JSON string: { events: [], grouped: bool, ... }
  faceCount   Int?
  bytes       Int?
  width       Int?
  height      Int?
  format      String?
  timestamp   DateTime             @default(now())
  session     AssessmentSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  violation   AssessmentViolation? @relation(fields: [violationId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([captureType])
  @@map("assessment_screenshots")
}

