// Prisma Schema for PWIOI Placement Portal
// Migrated from Firebase Firestore to PostgreSQL
// This project uses PostgreSQL database (Render).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTHENTICATION & USERS
// ============================================================================

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String // Hashed password (replaces Firebase Auth)
  role              String    @default("STUDENT") // UserRole: STUDENT, RECRUITER, ADMIN, SUPER_ADMIN
  status            String    @default("PENDING") // UserStatus: ACTIVE, PENDING, REJECTED, BLOCKED
  emailVerified     Boolean   @default(false)
  emailVerifiedAt   DateTime?
  recruiterVerified Boolean   @default(false) // For recruiter role

  // Profile fields (varies by role)
  displayName  String?
  profilePhoto String? // S3 URL

  // Block info (stored as JSON string)
  blockInfo String? // { type, endDate, reason, notes, blockedBy, blockedAt } as JSON string

  // Google Calendar integration
  googleCalendarConnected Boolean @default(false)
  connectedGoogleEmail    String? // Email of the connected Google Calendar account (must match user.email)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations
  student   Student?
  recruiter Recruiter?
  admin     Admin?

  // Auth relations
  refreshTokens       RefreshToken[]
  notifications       Notification[]
  queries             StudentQuery[]
  adminRequests       AdminRequest[]
  googleCalendarToken GoogleCalendarToken?

  @@index([email])
  @@index([role, status])
  @@map("users")
}

// Enums stored as String for simplicity
// UserRole: "STUDENT", "RECRUITER", "ADMIN", "SUPER_ADMIN"
// UserStatus: "ACTIVE", "PENDING", "REJECTED", "BLOCKED"

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model OTP {
  id        String   @id @default(uuid())
  email     String
  otp       String // 6-digit OTP
  purpose   String   @default("VERIFY_EMAIL") // VERIFY_EMAIL, RESET_PASSWORD, etc.
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, purpose, isUsed])
  @@index([expiresAt])
  @@map("otps")
}

// ============================================================================
// STUDENT PROFILES
// ============================================================================

model Student {
  id     String @id @default(uuid())
  userId String @unique

  // Basic Info
  fullName     String
  email        String   @unique
  phone        String
  enrollmentId String?  @unique // Optional during registration, user provides it later
  cgpa         Decimal?
  backlogs     String? // Number of backlogs (e.g., "0", "1", "2", "3+")

  // Academic Info
  batch  String // e.g., "25-29"
  center String // e.g., "BANGALORE", "NOIDA"
  school String // e.g., "SOT", "SOM", "SOH"

  // Profile
  bio            String?
  headline       String?
  summary        String? // Professional summary for resume
  city           String?
  stateRegion    String?
  jobFlexibility String?

  // Profile Image (Cloudinary)
  profileImageUrl      String? // Cloudinary URL
  profileImagePublicId String? // Cloudinary public_id for deletion

  // Social Profiles
  linkedin      String?
  githubUrl     String?
  youtubeUrl    String?
  leetcode      String?
  codeforces    String?
  gfg           String?
  hackerrank    String?
  otherProfiles String? // JSON string: [{platformName: string, profileId: string}]

  // Resume
  resumeUrl        String? // S3 URL
  resumeFileName   String?
  resumeUploadedAt DateTime?

  // Statistics
  statsApplied     Int @default(0)
  statsShortlisted Int @default(0)
  statsInterviewed Int @default(0)
  statsOffers      Int @default(0)

  // Email preferences
  emailNotificationsDisabled Boolean @default(false)

  // Public Profile Sharing
  publicProfileId String? @unique // UUID for public profile access (non-guessable)
  publicProfileShowEmail Boolean @default(true) // Toggle for email visibility in public profile
  publicProfileShowPhone Boolean @default(false) // Toggle for phone visibility in public profile

  // Endorsements (stored as JSON string - magic link system)
  endorsementsData String? // JSON array: [{ endorserName, endorserEmail, endorserRole, organization, message, relatedSkills, verified, submittedAt }]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications         Application[]
  skills               Skill[]
  education            Education[]
  projects             Project[]
  experiences          Experience[]
  achievements         Achievement[]
  certifications       Certification[]
  jobTracking          JobTracking[]
  codingProfiles       CodingProfile[]
  interviewEvaluations InterviewEvaluation[]
  resumeFiles          StudentResumeFile[]
  endorsements         Endorsement[] // Legacy endorsement system (query-based)
  endorsementTokens    EndorsementToken[]

  @@index([center, batch])
  @@index([school, batch])
  @@index([emailNotificationsDisabled, createdAt])
  @@map("students")
}

// Student Skills (array-based, stored as separate table)
model Skill {
  id        String   @id @default(uuid())
  studentId String
  skillName String
  rating    Int      @default(1) // 1-5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillName])
  @@index([studentId, skillName])
  @@map("skills")
}

// Educational Background
model Education {
  id          String   @id @default(uuid())
  studentId   String
  degree      String
  institution String
  startYear   Int?
  endYear     Int?
  cgpa        Decimal?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, endYear(sort: Desc)])
  @@map("education")
}

// Work Experience
model Experience {
  id          String   @id @default(uuid())
  studentId   String
  title       String
  company     String
  start       String // Start date (e.g., "2023-01" or "Jan 2023")
  end         String? // End date (null for current position)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, start(sort: Desc)])
  @@map("experiences")
}

// Projects
model Project {
  id               String   @id @default(uuid())
  studentId        String
  title            String
  description      String?
  technologies     String // Array of technologies (stored as JSON string)
  githubUrl        String?
  liveUrl          String?
  // AI-generated fields
  ai_summary       String? // AI-generated professional summary
  ai_bullets       String? // AI-generated bullet points (stored as JSON array string)
  skills_extracted String? // AI-extracted skills (stored as JSON array string)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt(sort: Desc)])
  @@map("projects")
}

// Achievements
model Achievement {
  id             String    @id @default(uuid())
  studentId      String
  title          String
  description    String?
  date           DateTime?
  hasCertificate Boolean   @default(false)
  certificateUrl String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt(sort: Desc)])
  @@map("achievements")
}

// Certifications (separate from achievements for clarity)
model Certification {
  id             String    @id @default(uuid())
  studentId      String
  title          String
  description    String?
  issuedDate     DateTime?
  expiryDate     DateTime?
  certificateUrl String?
  issuer         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, issuedDate(sort: Desc)])
  @@map("certifications")
}

// Coding Profiles
model CodingProfile {
  id         String   @id @default(uuid())
  studentId  String
  platform   String // 'leetcode', 'codeforces', 'gfg', 'hackerrank', 'github', 'linkedin', 'youtube'
  profileUrl String
  username   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, platform])
  @@index([studentId, platform])
  @@map("coding_profiles")
}

// ============================================================================
// COMPANIES
// ============================================================================

model Company {
  id          String   @id @default(uuid())
  name        String   @unique
  logo        String? // S3 URL
  website     String?
  location    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs       Job[]
  recruiters Recruiter[]

  @@index([name])
  @@map("companies")
}

// ============================================================================
// RECRUITERS
// ============================================================================

model Recruiter {
  id     String @id @default(uuid())
  userId String @unique

  // Company info (can be null if not linked to company)
  companyId   String?
  companyName String? // If not in companies table
  location    String?

  // Additional info
  relationshipType String? // 'Partner Company', etc.
  zone             String? // 'North Zone', etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])
  jobs    Job[]
  mouDocuments RecruiterMouDocument[]

  @@index([userId])
  @@map("recruiters")
}

model RecruiterMouDocument {
  id          String   @id @default(uuid())
  recruiterId String
  fileUrl     String   // Cloudinary URL
  publicId    String?  // Cloudinary public_id for deletion
  fileName    String?  // original filename
  createdAt   DateTime @default(now())

  recruiter Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@index([recruiterId])
  @@map("recruiter_mou_documents")
}

// ============================================================================
// JOBS
// ============================================================================

model Job {
  id String @id @default(uuid())

  // Basic Info
  jobTitle       String
  description    String
  requirements   String // Array of requirements (stored as JSON string)
  requiredSkills String // Array of skills (stored as JSON string)

  // Company & Recruiter
  companyId   String?
  recruiterId String?
  companyName String? // Fallback if companyId is null
  recruiterEmail String? // REQUIRED for new jobs: Primary email for recruiter/HR screening access (token-based) - kept for backward compatibility
  recruiterName  String? // Optional: Name of primary recruiter/HR contact - kept for backward compatibility
  recruiterEmails String? // JSON string: Array of recruiter/HR contacts [{email: string, name: string|null}] - supports multiple emails

  // Compensation
  salary      String? // Can be number or range string
  ctc         String?
  salaryRange String?

  // Location & Dates
  location            String?
  companyLocation     String?
  driveDate           DateTime // REQUIRED: Interview drive date - interviews cannot start before this
  applicationDeadline DateTime // REQUIRED: Last date/time students can apply - applications are permanently closed after this

  // Job Details
  jobType         String? // 'Full-time', 'Internship', etc.
  workMode        String? // 'Remote', 'Hybrid', 'On-site', etc.
  experienceLevel String?
  driveVenues     String // Array of venue strings (stored as JSON string)
  
  // Eligibility Requirements
  qualification   String? // Required qualification (e.g., "B.Tech", "M.Tech")
  specialization  String? // Specialization (e.g., "Computer Science", "Electronics")
  yop             String? // Year of Passing (e.g., "2024", "2025")
  minCgpa         String? // Minimum CGPA requirement (e.g., "7.00", "8.50", "70%")
  gapAllowed      String? // Gap allowed (e.g., "Yes", "No", "1 year")
  gapYears        String? // Maximum gap years allowed
  backlogs        String? // Backlogs allowed (e.g., "0", "1-2", "No")

  // SPOCs (Single Point of Contact) (stored as JSON string)
  spocs String // Array of { fullName, email, phone } as JSON string

  // Status
  status   String  @default("IN_REVIEW") // JobStatus: IN_REVIEW, APPROVED, REJECTED, POSTED
  isActive Boolean @default(false)
  isPosted Boolean @default(false)
  
  // Email trigger flag
  applicationDeadlineMailSent Boolean @default(false) // Flag to prevent duplicate deadline emails

  // Post-drive notes (after interview session ends)
  adminNote    String? // Note from admin about the placement drive (visible in Applicants section)
  recruiterNote String? // Note from recruiter about the drive (visible in Company History / Job Track)

  // Pre-Interview Requirements
  requiresScreening Boolean @default(false) // Resume screening required before interview
  requiresTest      Boolean @default(false) // QA/Test required before interview

  // Targeting (stored as JSON strings)
  targetSchools String // Array of schools or ["ALL"] (stored as JSON string)
  targetCenters String // Array of centers or ["ALL"] (stored as JSON string)
  targetBatches String // Array of batches or ["ALL"] (stored as JSON string)

  // Approval/Rejection
  submittedAt     DateTime?
  postedAt        DateTime?
  postedBy        String? // Admin user ID
  approvedAt      DateTime?
  approvedBy      String? // Admin user ID
  rejectedAt      DateTime?
  rejectedBy      String? // Admin user ID
  rejectionReason String?
  archivedAt      DateTime?
  archivedBy      String? // Admin user ID

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company          Company?          @relation(fields: [companyId], references: [id])
  recruiter        Recruiter?        @relation(fields: [recruiterId], references: [id])
  applications     Application[]
  jobTracking      JobTracking[]
  interviews       Interview[]
  interviewSession InterviewSession?
  screeningSession RecruiterScreeningSession?

  @@index([status, createdAt(sort: Desc)])
  @@index([isActive, createdAt(sort: Desc)])
  @@index([recruiterId, createdAt(sort: Desc)])
  @@index([isPosted, createdAt(sort: Desc)])
  @@index([applicationDeadline, applicationDeadlineMailSent, status]) // Index for deadline email trigger query
  @@map("jobs")
}

// JobStatus: "IN_REVIEW", "APPROVED", "REJECTED", "POSTED"

// Job Tracking (tracks which students have seen/available jobs)
model JobTracking {
  id        String    @id @default(uuid())
  studentId String
  jobId     String
  isNew     Boolean   @default(true)
  viewed    Boolean   @default(false)
  viewedAt  DateTime?
  applied   Boolean   @default(false)
  appliedAt DateTime?
  createdAt DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([studentId, jobId])
  @@index([studentId, createdAt(sort: Desc)])
  @@index([jobId])
  @@index([studentId, viewed])
  @@map("job_tracking")
}

// ============================================================================
// APPLICATIONS
// ============================================================================

model Application {
  id        String  @id @default(uuid())
  studentId String
  jobId     String
  companyId String?

  status        String    @default("APPLIED") // ApplicationStatus: APPLIED, SHORTLISTED, INTERVIEWED, OFFERED, SELECTED, REJECTED, JOB_REMOVED
  appliedDate   DateTime  @default(now()) // Date only (YYYY-MM-DD)
  interviewDate DateTime?

  // Pre-interview screening status (REQUIRED before interview)
  // Status progression: APPLIED -> SCREENING_SELECTED/SCREENING_REJECTED -> TEST_SELECTED/TEST_REJECTED -> INTERVIEW_ELIGIBLE
  screeningStatus String? @default("APPLIED") // ScreeningStatus: APPLIED, SCREENING_SELECTED, SCREENING_REJECTED, TEST_SELECTED, TEST_REJECTED, INTERVIEW_ELIGIBLE
  screeningRemarks String? // Optional remarks from recruiter during screening
  screeningCompletedAt DateTime? // When screening was finalized

  // Interview status tracking (for new interview system)
  interviewStatus  String? // Final status: "SELECTED", "REJECTED_IN_ROUND_1", "REJECTED_IN_ROUND_2", etc.
  lastRoundReached Int?    @default(0) // Last round number reached (0 = not started)

  // Additional notes
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  roundEvaluations RoundEvaluation[]

  @@unique([studentId, jobId]) // One application per student per job
  @@index([studentId, appliedDate(sort: Desc)])
  @@index([studentId, createdAt(sort: Desc)])
  @@index([jobId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([interviewStatus])
  @@index([screeningStatus])
  @@map("applications")
}

// ApplicationStatus: "APPLIED", "SHORTLISTED", "INTERVIEWED", "OFFERED", "SELECTED", "REJECTED", "JOB_REMOVED"

// ============================================================================
// RESUMES
// ============================================================================

model Resume {
  id       String @id @default(uuid())
  userId   String
  resumeId String @default("default") // For multiple resumes

  // Content
  originalText String @default("")
  enhancedText String @default("")
  previewMode  String @default("original") // 'original' | 'enhanced'

  // File info
  fileUrl  String? // S3 URL
  fileName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, resumeId])
  @@index([userId, resumeId])
  @@map("resumes")
}

// Student Resume Files - for storing multiple uploaded resume PDFs
model StudentResumeFile {
  id        String @id @default(uuid())
  studentId String
  userId    String // For easier querying

  // File info (Cloudinary)
  fileUrl  String // Cloudinary URL
  fileName String
  fileSize Int? // Size in bytes
  publicId String // Cloudinary public_id for deletion
  title    String? // Optional title for the resume

  // Default resume flag (only ONE can be true per student)
  isDefault Boolean @default(false)

  uploadedAt DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, uploadedAt(sort: Desc)])
  @@index([studentId, isDefault])
  @@index([userId, uploadedAt(sort: Desc)])
  @@map("student_resume_files")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String
  data      String    @default("{}") // Type-specific data (stored as JSON string)
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

// Email Notifications Queue
model EmailNotification {
  id         String    @id @default(uuid())
  jobId      String?
  userId     String?
  status     String    @default("PENDING") // EmailStatus: PENDING, SENT, FAILED
  recipients String // Array of email addresses (stored as JSON string)
  subject    String?
  body       String?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
  @@index([jobId, createdAt(sort: Desc)])
  @@map("email_notifications")
}

// EmailStatus: "PENDING", "SENT", "FAILED"

// ============================================================================
// STUDENT QUERIES (Support Tickets)
// ============================================================================

model StudentQuery {
  id          String    @id @default(uuid())
  studentId   String
  type        String    @default("question")
  subject     String
  message     String
  status      String    @default("OPEN") // QueryStatus: OPEN, RESOLVED, CLOSED
  metadata    String?   @default("{}")
  response    String?
  respondedBy String? // Admin user ID
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("student_queries")
}

// QueryStatus: "OPEN", "RESOLVED", "CLOSED"

// ============================================================================
// ENDORSEMENTS (Magic Link Based)
// ============================================================================

model Endorsement {
  id        String  @id @default(uuid())
  studentId String
  tokenId   String? @unique // Link to EndorsementToken (for tracking) - unique for one-to-one relation

  // Endorser Information (REQUIRED)
  endorserName  String // REQUIRED - Name of endorser
  endorserEmail String // FROM TOKEN (READ ONLY) - Email from token
  endorserRole  String // REQUIRED - Professor, Manager, Mentor, etc.
  organization  String // REQUIRED - Organization name

  // Relationship & Context
  relationship String // REQUIRED - Professor / Manager / Mentor / Guide
  context      String? // OPTIONAL - Course / Project / Internship / etc.

  // Endorsement Content
  message      String // REQUIRED - Endorsement message (10-2000 chars)
  skills       String  @default("[]") // JSON array of skills (stored as string)
  skillRatings String? // JSON object: { skill: rating } (optional)

  // Rating
  overallRating Int? // OPTIONAL - Overall rating (1-5)

  // Consent & Verification
  consent  Boolean @default(false) // REQUIRED - Must be true
  verified Boolean @default(true) // Verified via secure token

  // Timestamps
  createdAt   DateTime @default(now())
  submittedAt DateTime @default(now())

  // Relations
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  token   EndorsementToken? @relation(fields: [tokenId], references: [id])

  @@index([studentId, createdAt(sort: Desc)])
  @@index([endorserEmail])
  @@index([consent])
  @@map("endorsements")
}

// Endorsement Token Model (for magic link system)
model EndorsementToken {
  id        String    @id @default(uuid())
  studentId String
  email     String // Teacher/endorser email
  token     String    @unique // Cryptographically secure token
  expiresAt DateTime // 48 hours from creation
  used      Boolean   @default(false) // Single-use token
  usedAt    DateTime?
  ipAddress String? // IP address when token was used (for security logging)
  createdAt DateTime  @default(now())

  // Request metadata
  teacherName  String? // Optional: teacher name from request
  teacherRole  String? // Optional: Professor, Mentor, Panelist, etc.
  organization String? // Optional: organization name

  // Relations
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  endorsement Endorsement? // One-to-one: token can create one endorsement

  @@index([token])
  @@index([studentId, createdAt(sort: Desc)])
  @@index([email])
  @@index([used, expiresAt])
  @@map("endorsement_tokens")
}

// EndorsementStatus: "PENDING", "COMPLETED", "EXPIRED"

// ============================================================================
// ADMIN REQUESTS
// ============================================================================

model AdminRequest {
  id          String    @id @default(uuid())
  userId      String
  email       String
  reason      String?
  status      String    @default("PENDING") // RequestStatus: PENDING, APPROVED, REJECTED
  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  approvedBy  String? // Admin user ID
  rejectedAt  DateTime?
  rejectedBy  String? // Admin user ID

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, requestedAt(sort: Desc)])
  @@map("admin_requests")
}

// RequestStatus: "PENDING", "APPROVED", "REJECTED"

// ============================================================================
// ANNOUNCEMENTS (Admin → Students)
// ============================================================================

model Announcement {
  id            String   @id @default(uuid())
  title         String
  description   String   @db.Text
  link          String?  // Optional URL (e.g. form, opportunity, guideline)
  imageUrl      String?  // Cloudinary URL if admin uploads photo
  imagePublicId String?  // Cloudinary public_id for deletion
  // Targeting: JSON arrays e.g. ["SOT","SOM"] or ["ALL"] - which school/batch/center get the email
  targetSchools String?  // JSON array of school names, or ["ALL"]
  targetBatches String?  // JSON array of batch e.g. ["25-29"], or ["ALL"]
  targetCenters String?  // JSON array of center e.g. ["BANGALORE"], or ["ALL"]
  createdBy     String   // User ID of admin
  createdAt     DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@map("announcements")
}

// ============================================================================
// ADMIN MODEL (Additional admin-specific data)
// ============================================================================

model Admin {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admins")
}

// ============================================================================
// GOOGLE CALENDAR TOKENS
// ============================================================================

model GoogleCalendarToken {
  id                   String    @id @default(uuid())
  userId               String    @unique
  accessToken          String
  refreshToken         String?
  expiryDate           DateTime?
  scope                String?
  connectedGoogleEmail String? // Email of the connected Google Calendar account (for verification)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([connectedGoogleEmail])
  @@map("google_calendar_tokens")
}

// ============================================================================
// INTERVIEW SESSIONS
// ============================================================================

model Interview {
  id           String  @id @default(uuid())
  jobId        String
  companyId    String?
  status       String  @default("ONGOING") // InterviewStatus: ONGOING, COMPLETED, CANCELLED
  currentRound String? // Name of the current round
  rounds       String  @default("[]") // JSON array of rounds: [{ name, criteria, status, order }]

  // Statistics
  totalCandidates    Int @default(0)
  doneCandidates     Int @default(0)
  pendingCandidates  Int @default(0)
  selectedCandidates Int @default(0)
  onHoldCandidates   Int @default(0)

  // Creator
  createdBy String? // User ID of the admin who created the interview

  // Session Token (for token-based access without login)
  sessionToken String? @unique // Unique token for session access

  // Timestamps
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // Relations
  job         Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  evaluations InterviewEvaluation[]
  activities  InterviewActivity[]

  @@unique([jobId])
  @@index([status, startedAt(sort: Desc)])
  @@index([jobId])
  @@index([createdBy])
  @@index([sessionToken])
  @@map("interviews")
}

model InterviewEvaluation {
  id          String   @id @default(uuid())
  interviewId String
  studentId   String
  roundName   String
  marks       Float?
  remarks     String?
  status      String? // EvaluationStatus: SELECTED, REJECTED, ON_HOLD
  evaluatedBy String? // User ID of the evaluator
  evaluatedAt DateTime @default(now())

  // Relations
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([interviewId, studentId, roundName])
  @@index([interviewId, roundName])
  @@index([studentId])
  @@map("interview_evaluations")
}

model InterviewActivity {
  id           String   @id @default(uuid())
  interviewId  String
  studentId    String?
  roundName    String?
  activityType String // ActivityType: SESSION_STARTED, ROUND_STARTED, EVALUATION, SESSION_ENDED
  message      String
  metadata     String? // JSON string for additional data: { candidateId, roundName, status, etc. }
  performedBy  String? // User ID
  createdAt    DateTime @default(now())

  // Relations
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId, createdAt(sort: Desc)])
  @@index([activityType])
  @@map("interview_activities")
}

// ============================================================================
// INTERVIEW SESSIONS (New Production System)
// ============================================================================

model InterviewSession {
  id        String  @id @default(uuid())
  jobId     String  @unique
  companyId String?

  status String @default("NOT_STARTED") // SessionStatus: NOT_STARTED, ONGOING, COMPLETED, INCOMPLETE, FROZEN

  // Creator
  createdBy String // Admin user ID

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  // Relations
  job                Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rounds             InterviewRound[]
  interviewerInvites InterviewerInvite[]

  @@index([status, createdAt(sort: Desc)])
  @@index([jobId])
  @@index([createdBy])
  @@map("interview_sessions")
}

// SessionStatus: "NOT_STARTED", "ONGOING", "COMPLETED", "INCOMPLETE"

model InterviewRound {
  id          String @id @default(uuid())
  sessionId   String
  roundNumber Int // 1, 2, 3, etc.
  name        String // e.g., "Technical Round 1", "HR Round"

  status String @default("LOCKED") // RoundStatus: LOCKED, ACTIVE, ENDED

  // Timestamps
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  session     InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evaluations RoundEvaluation[]

  @@unique([sessionId, roundNumber])
  @@unique([sessionId, name])
  @@index([sessionId, roundNumber])
  @@index([status])
  @@map("interview_rounds")
}

// RoundStatus: "LOCKED", "ACTIVE", "ENDED"

model InterviewerInvite {
  id        String    @id @default(uuid())
  sessionId String
  email     String
  token     String    @unique // JWT or signed random token
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Relations
  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, email])
  @@index([token])
  @@index([sessionId])
  @@index([email])
  @@index([used, expiresAt])
  @@map("interviewer_invites")
}

model RoundEvaluation {
  id               String @id @default(uuid())
  roundId          String
  applicationId    String
  interviewerEmail String

  status  String? // EvaluationStatus: SELECTED, REJECTED, ON_HOLD
  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  round       InterviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  application Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([roundId, applicationId]) // One evaluation per candidate per round
  @@index([roundId])
  @@index([applicationId])
  @@index([status])
  @@map("round_evaluations")
}

// EvaluationStatus: "SELECTED", "REJECTED", "ON_HOLD"

// ============================================================================
// RECRUITER SCREENING SESSIONS
// ============================================================================

model RecruiterScreeningSession {
  id        String   @id @default(uuid())
  jobId     String   @unique
  token     String   @unique // Secure random token or JWT for access
  expiresAt DateTime // Token expiration (7-14 days)
  createdAt DateTime @default(now())

  // Relations
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([jobId])
  @@index([expiresAt])
  @@map("recruiter_screening_sessions")
}
