# Database
DATABASE_URL=postgresql://portal_user:portal_password@postgres:5432/portal_db

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production
SUPER_ADMIN_EMAIL=admin@pwioi.in
SUPER_ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=admin@pwioi.in
ADMIN_PASSWORD=Admin@123
STUDENT_EMAIL=charansai82140@gmail.com
STUDENT_PASSWORD=Student@123

# Server
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Redis
REDIS_URL=redis://redis:6379

# Email (optional - set if you have SMTP configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Cloudinary (optional - for file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Placement policy
REQUIRE_EMAIL_VERIFIED=true
PLACEMENT_MAX_ACTIVE_OFFERS=1
PLACEMENT_BLOCK_WHEN_JOINED=true
PLACEMENT_BLOCK_DUAL_DREAM=true
PLACEMENT_MIN_MOCKS=0
PLACEMENT_MIN_ASSESSMENTS=0
PLACEMENT_SUPER_DREAM_MIN_CGPA=8

# Database pool settings
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT=30

# Student directory
DIRECTORY_INACTIVITY_DAYS=45
DIRECTORY_NO_SHOW_THRESHOLD=3

# Judge0 CE (self-hosted) — code execution for assessments
JUDGE0_ENABLED=true
JUDGE0_PROVIDER=selfhosted
JUDGE0_API_URL=http://judge0-server:2358
