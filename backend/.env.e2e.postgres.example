# Copy to .env.e2e.postgres and adjust for local PostgreSQL E2E runs.
# NEVER point at production or development databases.

E2E=1
E2E_DB=postgres
NODE_ENV=development
PORT=3100

DATABASE_URL=postgresql://portal_e2e:e2e_postgres_pass@localhost:5433/portal_e2e

JWT_SECRET=e2e-jwt-secret-not-for-production
JWT_REFRESH_SECRET=e2e-refresh-secret-not-for-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5174

SUPER_ADMIN_EMAIL=e2e.super@pwioi.test
E2E_PASSWORD=E2ePass#143

JUDGE0_ENABLED=false
AI_ENABLED=false
DISABLE_RATE_LIMIT=true
PLACEMENT_MAX_ACTIVE_OFFERS=10
PLACEMENT_BLOCK_WHEN_JOINED=false
REQUIRE_EMAIL_VERIFIED=false
