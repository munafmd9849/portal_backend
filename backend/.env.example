# Portal Backend — environment reference (copy to .env)

# Database — SQLite for local dev (recommended)
DATABASE_URL=file:./dev.db
# One-time copy from Render Postgres → SQLite: npm run db:pull-from-postgres
POSTGRES_SOURCE_URL=postgresql://user:password@host/db?sslmode=require

# Auth
JWT_SECRET=change-me-in-production

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Cloudinary (uploads + CSV exports)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (queues, CSV export worker)
REDIS_URL=redis://localhost:6379

# Google OAuth / Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Sheets export (optional)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# Placement policy (MVP engine)
REQUIRE_EMAIL_VERIFIED=true
PLACEMENT_MAX_ACTIVE_OFFERS=1
PLACEMENT_BLOCK_WHEN_JOINED=true
PLACEMENT_BLOCK_DUAL_DREAM=true
PLACEMENT_MIN_MOCKS=0
PLACEMENT_MIN_ASSESSMENTS=0
PLACEMENT_SUPER_DREAM_MIN_CGPA=8

# Database pool (Render / Postgres)
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT=30

# Student directory
DIRECTORY_INACTIVITY_DAYS=45
DIRECTORY_NO_SHOW_THRESHOLD=3

# Legacy — YOP is always enforced when job.yop is set (ENFORCE_YOP no longer required)
