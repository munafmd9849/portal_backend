# Production environment — copy to .env and fill with real values.
# NEVER commit this file with real credentials.

NODE_ENV=production
PORT=3000

# === REQUIRED — startup fails without these ===
JWT_SECRET=<generate-a-strong-64-char-random-secret>
JWT_REFRESH_SECRET=<generate-a-different-64-char-random-secret>
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

SUPER_ADMIN_EMAIL=<your-super-admin-email@domain.com>

DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require

# Managed Redis (Redis Cloud / Upstash) — portal queues only (NOT Judge0's Redis)
# Sign up → create database → paste the connection URL they give you.
# REDIS_URL alone is enough; remove REDIS_HOST / REDIS_PORT if set.
#
# Redis Cloud (redis.io) example:
# REDIS_URL=redis://default:YOUR_PASSWORD@redis-12345.c1.us-east-1-2.ec2.redns.redis-cloud.com:12345
#
# Upstash example (often TLS):
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR-NAME.upstash.io:6379
#
REDIS_URL=redis://default:<password>@<host>:<port>

FRONTEND_URL=https://<your-production-domain>
CORS_ORIGIN=https://<your-production-domain>

# === OPTIONAL — features degrade gracefully without these ===

# SMTP (screening emails, notifications)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (SSO login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://<your-domain>/api/auth/google/callback

# AI services (mock interviews)
GOOGLE_AI_API_KEY=
MISTRAL_API_KEY=

# Code execution — self-hosted Judge0 CE (coding assessments)
JUDGE0_ENABLED=true
JUDGE0_PROVIDER=selfhosted
# PM2 on same host (Judge0 in judge0/docker-compose.yml):
JUDGE0_API_URL=http://127.0.0.1:2358
# Docker production (docker-compose.prod.yml overrides to http://judge0-server:2358):
# JUDGE0_API_URL=http://judge0-server:2358
JUDGE0_AUTH_TOKEN=<same-token-as-judge0.conf-AUTHN_TOKEN>
# Optional limits (seconds / KB)
# JUDGE0_CPU_TIME_LIMIT=2
# JUDGE0_WALL_TIME_LIMIT=5
# JUDGE0_MEMORY_LIMIT=128000

# Placement config
PLACEMENT_MAX_ACTIVE_OFFERS=10
PLACEMENT_BLOCK_WHEN_JOINED=true
