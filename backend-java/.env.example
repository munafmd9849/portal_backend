# Copy of Node backend/.env keys used by Spring Boot 4 (no secrets).
# Copy backend/.env → backend-java/.env or keep using ../backend/.env

PORT=3000
SOCKET_PORT=3001
NODE_ENV=development

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

DATABASE_URL=postgresql://postgres:root123@localhost:5432/placement_portal
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT=30

REDIS_URL=redis://localhost:6379

JUDGE0_ENABLED=true
JUDGE0_PROVIDER=selfhosted
JUDGE0_API_URL=http://localhost:2358

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

AI_PROVIDER=google
AI_ENABLED=true
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

REQUIRE_EMAIL_VERIFIED=true
PLACEMENT_MAX_ACTIVE_OFFERS=1
PLACEMENT_BLOCK_WHEN_JOINED=true
PLACEMENT_BLOCK_DUAL_DREAM=true
PLACEMENT_MIN_MOCKS=0
PLACEMENT_MIN_ASSESSMENTS=0
PLACEMENT_SUPER_DREAM_MIN_CGPA=8
