# Copy to frontend/.env and restart `npm run dev` after changes.

# --- Backend (required) ---
# Same machine (two browser tabs): localhost is fine.
# Two laptops on Wi‑Fi: open the HTTPS Network URL printed by `npm run dev`
# (camera is blocked on http://LAN-IP). API and sockets go through Vite `/api`
# and `/socket.io` — you do not need to put the LAN IP in these three vars.
#
# Example LAN (host IP 192.168.1.42):
# VITE_API_BASE_URL=http://localhost:3000/api
# VITE_SOCKET_URL=http://localhost:3000
# VITE_FRONTEND_URL=http://localhost:5173
#
# Also add the LAN origin to backend CORS_ORIGIN, e.g.:
# CORS_ORIGIN=http://localhost:5173,https://localhost:5173,https://192.168.1.42:5173
VITE_API_BASE_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000
VITE_FRONTEND_URL=http://localhost:5173

# --- WebRTC live proctoring — Metered TURN (optional) ---
# Recommended: configure backend/.env (METERED_DOMAIN + METERED_TURN_API_KEY).
# Frontend fetches ICE servers from GET /api/webrtc/turn-ice-servers — never put Secret Key here.
#
# VITE_METERED_DOMAIN=yourapp.metered.live
VITE_METERED_DOMAIN=
#
# Optional static override — paste from Metered "Show ICE Servers Array":
# VITE_TURN_STUN_URL=stun:stun.relay.metered.ca:80
# VITE_TURN_URL=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:443,...
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
VITE_TURN_STUN_URL=
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Optional: Jitsi domain for mock interviews
# VITE_JITSI_DOMAIN=meet.jit.si
